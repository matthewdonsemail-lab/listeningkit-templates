    "command": "prop.setExpression",
    "params": {
      "layer": "text",
      "path": "transform/anchor",
      "expression": "var m; try { m = thisLayer.marker.key(\"in\"); } catch (e) { m = null; }\nvar r = sourceRectAtTime(m ? m.time + m.duration + 0.5 : time, false);\n[r.left + r.width / 2, r.top + r.height / 2, 0]"
    }
  },
  {
    "command": "prop.setExpression",
    "params": {
      "layer": "text",
      "path": "transform/scale",
      "expression": "var cs = effect(\"Continuous Scale\")(\"Slider\"), f = thisComp.frameDuration;\nfunction markerKey(name) { try { return thisLayer.marker.key(name); } catch (e) { return null; } }\nvar keys = [[0, 0], [2 * f, 126], [3 * f, 94], [4 * f, 100]];\nfunction pop(t) {\n  if (t <= 0) return 0;\n  for (var j = 1; j < keys.length; j++) if (t <= keys[j][0]) return keys[j - 1][1] + (keys[j][1] - keys[j - 1][1]) * (t - keys[j - 1][0]) / (keys[j][0] - keys[j - 1][0]);\n  return 100;\n}\nvar mIn = markerKey(\"in\"), mOut = markerKey(\"out\");\nvar p = mIn ? pop(time - mIn.time) : 100;\nif (mOut && time >= mOut.time) p = pop(mOut.time + 4 * f - time);\nvar s = (p / 100) * Math.max(1 + (cs / 100) * Math.max(time - (mIn ? mIn.time : 0), 0), 0);\n[100 * s, 100 * s, 100]"
    }
  },
  {
    "command": "prop.setExpression",
    "params": {
      "layer": "text",
      "path": "transform/rotation",
      "expression": "-3 + effect(\"Wobble\")(\"Slider\") * Math.cos(time * 2 * Math.PI * 2.5)"
    }
  },
