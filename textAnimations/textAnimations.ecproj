                            "t": "Vec2",
                            "v": [
                              960.0,
                              0.0
                            ]
                          },
                          "expr": {
                            "text": "var p = Math.min(Math.max(thisComp.layer(\"controls\").effect(\"Wipe\")(\"Slider\"), 0), 100) / 100;\nvar cell = Math.max(thisComp.layer(\"upper\").effect(2)(\"cell_size\"), 1);\nvar up = 378, low = 491, H = thisComp.height;\nvar top = H - p * (H + up + low + cell);\nvar split = Math.round((top + up) / cell) * cell;\nvar bottom = split + low;\nvar bottomRow = Math.ceil(bottom / cell) * cell;\n[thisComp.width / 2, top]",
                            "enabled": true
                          },
                          "ui": {
                            "kind": "Point"
