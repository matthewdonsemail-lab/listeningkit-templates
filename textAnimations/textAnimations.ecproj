                      "match": "scale",
                      "name": "Scale",
                      "value": {
                        "t": "Vec3",
                        "v": [
                          100.0,
                          100.0,
                          100.0
                        ]
                      },
                      "expr": {
                        "text": "var c = thisComp.layer(\"controls\"), ov = c.effect(\"Overshoot\")(\"Slider\"), pop = Math.max(c.effect(\"Pop Time\")(\"Slider\"), 0.001), n = 12;\nfunction markerKey(name) { try { return c.marker.key(name); } catch (e) { return null; } }\nfunction clamp(t) { return Math.min(Math.max(t, 0), 1); }\nfunction wordGap(m) { var p = Math.min(pop, m.duration > 0 ? m.duration : pop); return { p: p, g: n > 1 ? Math.max(m.duration - p, 0) / (n - 1) : 0 }; }\nfunction backOut(t) { var u = t - 1; return 1 + (ov + 1) * u * u * u + ov * u * u; }\nfunction backIn(t) { return (ov + 1) * t * t * t - ov * t * t; }\nvar mIn = markerKey(\"in\"), mOut = markerKey(\"out\");\nvar i = 7;\nfunction progress(m) { var q = wordGap(m); return clamp((time - m.time - i * q.g) / q.p); }\nvar s = mIn ? backOut(progress(mIn)) : 1;\nif (mOut && time >= mOut.time) s = 1 - backIn(progress(mOut));\nvar cc = thisComp.layer(\"controls\"), gcs = cc.effect(\"Continuous Scale\")(\"Slider\");\nvar gIn; try { gIn = cc.marker.key(\"in\"); } catch (e) { gIn = null; }\nvar grow = Math.max(1 + (gcs / 100) * Math.max(time - (gIn ? gIn.time : 0), 0), 0);\nvar cx = thisComp.width / 2, cy = 678;\ns = Math.max(s, 0) * grow;\n[100 * s, 100 * s, 100]",
                        "enabled": true
                      },
                      "ui": {
                        "kind": "Percent"
                      },
