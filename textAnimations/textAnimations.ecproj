                      },
                      "expr": {
                        "text": "var c = thisComp.layer(\"controls\");\nvar f = Math.max(c.effect(\"Zoom\")(\"Slider\"), 1) / 40, px = c.effect(\"Padding X\")(\"Slider\"), py = c.effect(\"Padding Y\")(\"Slider\"), gap = c.effect(\"Gap\")(\"Slider\");\nvar rowH = 40 * f + 2 * py;\nfunction brickW(brick) { return thisComp.layer(brick).effect(1)(1); }\nvar row = [\"brick 09-01\",\"brick 09-02\",\"brick 09-03\",\"brick 09-04\",\"brick 09-05\",\"brick 09-06\",\"brick 09-07\",\"brick 09-08\"], j = 4, r = 8;\nvar x = -(r % 2) * 70 * f;\nfor (var k = 0; k < j; k++) x += brickW(row[k]) + gap;\nx += brickW(row[j]) / 2;\nvar y = gap / 2 + rowH / 2 + r * (rowH + gap);\n[x, y]",
                        "enabled": true
                      },
                      "ui": {
                        "kind": "Point"
                      },
                      "spatial": true,
                      "hold_only": false,
                      "three_d_only": false,
