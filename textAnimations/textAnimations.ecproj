                      },
                      "expr": {
                        "text": "var c = thisComp.layer(\"controls\");\nvar build = c.effect(\"Build\")(\"Slider\"), ov = c.effect(\"Overshoot\")(\"Slider\");\nvar n = 72, place = 33, w = 100 / n * 4;\nvar t = Math.min(Math.max((build - place / n * (100 - w)) / w, 0), 1), u = t - 1;\nvar s = t <= 0 ? 0 : 1 + (ov + 1) * u * u * u + ov * u * u;\n[100 * s, 100 * s]",
                        "enabled": true
                      },
                      "ui": {
                        "kind": "Percent"
