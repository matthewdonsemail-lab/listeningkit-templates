                                          100.0,
                                          100.0,
                                          100.0
                                        ]
                                      },
                                      "expr": {
                                        "text": "var ov = effect(\"Letter Overshoot\")(\"Slider\"), pop = Math.max(effect(\"Pop Time\")(\"Slider\"), 0.001);\nfunction markerKey(name) { try { return thisLayer.marker.key(name); } catch (e) { return null; } }\nfunction clamp(t) { return Math.min(Math.max(t, 0), 1); }\nvar n = Math.max(textTotal, 1), i = textIndex - 1;\nfunction progress(m) {\n  var p = Math.min(pop, m.duration > 0 ? m.duration : pop);\n  var gap = n > 1 ? Math.max(m.duration - p, 0) / (n - 1) : 0;\n  return clamp((time - m.time - i * gap) / p);\n}\nfunction backOut(t) { var u = t - 1; return 1 + (ov + 1) * u * u * u + ov * u * u; }\nfunction backIn(t) { return (ov + 1) * t * t * t - ov * t * t; }\nvar mIn = markerKey(\"in\"), mOut = markerKey(\"out\");\nvar s = mIn ? backOut(progress(mIn)) : 1;\nif (mOut && time >= mOut.time) s = 1 - backIn(progress(mOut));\nvar a = 100 * (1 - s);\n[a, a, a]",
                                        "enabled": true
                                      },
                                      "ui": {
                                        "kind": "Percent"
                                      },
                                      "spatial": false,
                                      "hold_only": false,
                                      "three_d_only": false,
                                      "two_d_only": false,
                                      "shown_dims": 0,
