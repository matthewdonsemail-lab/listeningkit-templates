                    },
                    {
                      "node": "Prop",
                      "uid": 6484,
                      "match": "scale",
                      "name": "Scale",
                      "value": {
                        "t": "Vec3",
                        "v": [
                          100.0,
                          100.0,
                          100.0
                        ]
                      },
                      "expr": {
                        "text": "var ov = effect(\"Whole Overshoot\")(\"Slider\");\nfunction markerKey(name) { try { return thisLayer.marker.key(name); } catch (e) { return null; } }\nfunction progress(m) { return Math.min(Math.max((time - m.time) / Math.max(m.duration, 0.001), 0), 1); }\nfunction backOut(t) { var u = t - 1; return 1 + (ov + 1) * u * u * u + ov * u * u; }\nfunction backIn(t) { return (ov + 1) * t * t * t - ov * t * t; }\nvar mIn = markerKey(\"in\"), mOut = markerKey(\"out\");\nvar s = mIn ? backOut(progress(mIn)) : 1;\nif (mOut && time >= mOut.time) s = 1 - backIn(progress(mOut));\nvar cs = 0; try { cs = effect(\"Continuous Scale\")(\"Slider\"); } catch (e) { cs = 0; }\ns *= Math.max(1 + (cs / 100) * Math.max(time - (mIn ? mIn.time : 0), 0), 0);\ns = Math.max(s, 0);\n[100 * s, 100 * s, 100]",
                        "enabled": true
                      },
                      "ui": {
                        "kind": "Percent"
                      },
                      "spatial": false,
                      "hold_only": false,
                      "three_d_only": false,
                      "two_d_only": false,
                      "shown_dims": 2,
                      "static_only": false
