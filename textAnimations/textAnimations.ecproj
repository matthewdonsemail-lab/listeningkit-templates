                          0.0,
                          0.0
                        ]
                      },
                      "ui": {
                        "kind": "Angle"
                      },
                      "spatial": false,
                      "hold_only": false,
                      "three_d_only": true,
                      "two_d_only": false,
                      "shown_dims": 0,
                      "static_only": false
