                  "children": [
                    {
                      "node": "Group",
                      "uid": 5201,
                      "match": "ec.control.slider",
                      "name": "Slider Control",
                      "kind": {
                        "kind": "Effect",
                        "effect": "ec.control.slider"
                      },
                      "enabled": true,
                      "children": [
                        {
                          "node": "Prop",
                          "uid": 5202,
                          "match": "slider",
                          "name": "Slider",
                          "value": {
                            "t": "Scalar",
                            "v": 0.0
                          },
                          "expr": {
                            "text": "var c = thisComp.layer(\"controls\");\nvar f = Math.max(c.effect(\"Zoom\")(\"Slider\"), 1) / 40, px = c.effect(\"Padding X\")(\"Slider\"), py = c.effect(\"Padding Y\")(\"Slider\"), gap = c.effect(\"Gap\")(\"Slider\");\nvar rowH = 40 * f + 2 * py;\nfunction brickW(brick) { return thisComp.layer(brick).effect(1)(1); }\nthisComp.layer(\"word 01-01\").sourceRectAtTime(time, false).width * f + 2 * px",
                            "enabled": true
                          },
                          "ui": {
                            "kind": "Slider",
                            "min": -1000000.0,
                            "max": 1000000.0,
                            "slider_min": 0.0,
