                      "expr": {
                        "text": "var cs = 0; try { cs = effect(\"Continuous Scale\")(\"Slider\"); } catch (e) { cs = 0; }\nvar s = Math.max(1 + (cs / 100) * Math.max(time - inPoint, 0), 0);\n[100 * s, 100 * s, 100]",
