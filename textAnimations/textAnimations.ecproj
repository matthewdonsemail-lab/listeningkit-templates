                    {
                      "node": "Prop",
                      "uid": 5702,
                      "match": "anchor",
                      "name": "Anchor Point",
                      "value": {
                        "t": "Vec3",
                        "v": [
                          0.0,
                          0.0,
                          0.0
                        ]
                      },
                      "expr": {
                        "text": "var r = sourceRectAtTime(0, false);\n[r.left + r.width / 2, -16, 0]",
                        "enabled": true
                      },
                      "ui": {
                        "kind": "Point"
                      },
                      "spatial": true,
                      "hold_only": false,
                      "three_d_only": false,
