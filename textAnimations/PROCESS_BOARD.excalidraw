"736ebf511d95389b", "type": "text", "x": 5600, "y": 1829, "width": 743.6, "height": 32.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 359453190, "version": 1, "versionNonce": 518446124, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "Frames from the final render, each with its timecode", "fontSize": 26, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Frames from the final render, each with its timecode", "lineHeight": 1.25, "baseline": 26}, {"id": "be77344828b09a93", "type": "image", "x": 5600, "y": 1873, "width": 960, "height": 1350, "angle": 0, "strokeColor": "transparent", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 220834651, "version": 1, "versionNonce": 934376222, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "status": "saved", "fileId": "7da48c5d2cb093b4d14375bbfd97c52011d0b76c", "scale": [1, 1]}, {"id": "f6f62c28e927db48", "type": "arrow", "x": 6740, "y": -95, "width": 220, "height": 0, "angle": 0, "strokeColor": "#e03131", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 4, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 2}, "seed": 812344244, "version": 1, "versionNonce": 631410834, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "points": [[0, 0], [220, 0]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": "arrow"}, {"id": "40df7c9a8cda80a3", "type": "text", "x": 7000, "y": -120, "width": 528.0, "height": 60.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1024371383, "version": 1, "versionNonce": 675297153, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "5  IMAGE GENERATIONS", "fontSize": 48, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "5  IMAGE GENERATIONS", "lineHeight": 1.25, "baseline": 48}, {"id": "35263b4519a2105c", "type": "text", "x": 7000, "y": 0, "width": 1000, "height": 264, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 681646404, "version": 1, "versionNonce": 85083776, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "HOW THE STILLS WERE GENERATED (images/gen/make_*.py)\n- Nano Banana Pro / Gemini 3 Pro Image, through treg or Google's API with the\n  references sent inline (about $0.15 an image)\n- chained in rounds: the first image (the cast sheet, the standing girl) is the\n  reference for every later shot, so faces and clothes stay the same\n- camera, crop and pose locked across versions, so they cut and glitch in place\n- text on screens and boards left out, added as editable layers\n- the raw generation kept beside the cleaned one (_raw.png)", "fontSize": 26, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "HOW THE STILLS WERE GENERATED (images/gen/make_*.py)\n- Nano Banana Pro / Gemini 3 Pro Image, through treg or Google's API with the\n  references sent inline (about $0.15 an image)\n- chained in rounds: the first image (the cast sheet, the standing girl) is the\n  reference for every later shot, so faces and clothes stay the same\n- camera, crop and pose locked across versions, so they cut and glitch in place\n- text on screens and boards left out, added as editable layers\n- the raw generation kept beside the cleaned one (_raw.png)", "lineHeight": 1.25, "baseline": 26}, {"id": "02b087f806faadb1", "type": "text", "x": 7000, "y": 384, "width": 1215.5, "height": 32.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 634688482, "version": 1, "versionNonce": 687734372, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "make_opening_dawn.py: the marble hall at dawn, the crowd, the light-beings, the split", "fontSize": 26, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "make_opening_dawn.py: the marble hall at dawn, the crowd, the light-beings, the split", "lineHeight": 1.25, "baseline": 26}, {"id": "642a357c732902f4", "type": "image", "x": 7000, "y": 428, "width": 1000, "height": 375, "angle": 0, "strokeColor": "transparent", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 672765533, "version": 1, "versionNonce": 855890699, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "status": "saved", "fileId": "70b95a9377b75822208040ae04f01c3a074b41cc", "scale": [1, 1]}, {"id": "106ee2ab101e75eb", "type": "text", "x": 7000, "y": 923, "width": 886.6, "height": 32.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 681502932, "version": 1, "versio