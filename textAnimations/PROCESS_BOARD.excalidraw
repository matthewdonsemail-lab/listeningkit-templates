ffa1b1bf1", "type": "text", "x": 2800, "y": -120, "width": 633.6, "height": 60.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 968182334, "version": 1, "versionNonce": 479309281, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "2  PULLED OUT WITH NUMPY", "fontSize": 48, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "2  PULLED OUT WITH NUMPY", "lineHeight": 1.25, "baseline": 48}, {"id": "a6048457861e02ec", "type": "text", "x": 2800, "y": 0, "width": 1000, "height": 231, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 65928339, "version": 1, "versionNonce": 848037023, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "HOW THE NUMPY EXTRACTION WORKS\n- every frame read with OpenCV\n- masks by colour and brightness (HSV thresholds) pull out just the effect\n- the rest made transparent, written as PNG / ProRes 4444 layers\n- lines thinned to skeletons and traced into paths\n- those shapes and paths saved as SEEDS\n- generators then draw NEW variations from the seeds along a path or out of a matte (a face, a word, the eyes)", "fontSize": 26, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "HOW THE NUMPY EXTRACTION WORKS\n- every frame read with OpenCV\n- masks by colour and brightness (HSV thresholds) pull out just the effect\n- the rest made transparent, written as PNG / ProRes 4444 layers\n- lines thinned to skeletons and traced into paths\n- those shapes and paths saved as SEEDS\n- generators then draw NEW variations f