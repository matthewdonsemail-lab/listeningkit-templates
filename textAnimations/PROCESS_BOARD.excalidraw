eColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 339081109, "version": 1, "versionNonce": 104279226, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "6  THE EFFECTCRAFT WALKTHROUGH", "fontSize": 48, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "6  THE EFFECTCRAFT WALKTHROUGH", "lineHeight": 1.25, "baseline": 48}, {"id": "dcb284f8b6febc3a", "type": "text", "x": 8400, "y": 0, "width": 1000, "height": 396, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 531066030, "version": 1, "versionNonce": 542425183, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "HOW THE 20-MINUTE WALKTHROUGH WAS EDITED (FilmCraft)\n- an hour-long screen recording of matt explaining EffectCraft\n- the voice cleaned with RE-USE on a Colab T4, in three parts\n- the transcript turned into a cut list: 20 minutes, sentences kept whole\n- every pause of 0.30 s+ cut out (179 pauses down to 66)\n- every cut a J-cut: the voice comes in 8+ frames before the picture\n- bust-shot close-ups of matt on whole talking sentences\n- the intro built in EffectCraft: CRT, dark gradient, matt cut out above it,\n  words in the empty space, 8-bit letter swaps, deep glow, a riser, a flash\n- the launch film, the actual Big Short and 23 of this board's breakdowns cut in\n  where he talks about them\n- rendered as ProRes in 4 pieces, then x264 CRF 16: 1080p60, ~9.8 Mbps; .srt beside it", "fontSize": 26, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "HOW THE 20-MINUTE WALKTHROUGH WAS EDITED (FilmCraft)\n- an hour-long screen recording of matt explaining EffectCraft\n- the voice cleaned with RE-USE on a Colab T4, in three parts\n- the transcript turned into a cut list: 20 minutes, sentences kept whole\n- every pause of 0.30 s+ cut out (179 pauses down to 66)\n- every cut a J-cut: the voice comes in 8+ frames before the picture\n- bust-shot close-ups of matt on whole talking sentences\n- the intro built in EffectCraft: CRT, dark gradient, matt cut out above it,\n  words in the empty space, 8-bit letter swaps, deep glow, a riser, a flash\n- the launch film, the actual Big Short and 23 of this board's breakdowns cut in\n  where he talks about them\n- rendered as ProRes in 4 pieces, then x264 CRF 16: 1080p60, ~9.8 Mbps; .srt beside it", "lineHeight": 1.25, "baseline": 26}, {"id": "107d72d5c71c5cf1", "type": "text", "x": 8400, "y": 516, "width": 757.9000000000001, "height": 32.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 959270190, "version": 1, "versionNonce": 923786071, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "[00:00:00 - 00:00:17] The intro, built in EffectCraft", "fontSize": 26, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "[00:00:00 - 00:00:17] The intro, built in EffectCraft", "lineHeight": 1.25, "baseline": 26}, {"id": "400e67ed8c9cf440", "type": "image", "x": 8400, "y": 560, "width": 960, "height": 810, "angle": 0, "strokeColor": "transparent", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 943601755, "version": 1, "versionNonce": 973475123, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked