 "speech": [
  {
   "start": 2.93,
   "end": 5.43,
   "text": "You're still mostly Gannick?"
  },
  {
   "start": 6.43,
   "end": 7.43,
   "text": "Why?"
  },
  {
   "start": 11.84,
   "end": 13.34,
   "text": "They're all still here."
  },
  {
   "start": 14.34,
   "end": 18.34,
   "text": "They come to me in my dreams, asking for help, but I never can."
  },
  {
   "start": 19.84,
   "end": 21.84,
   "text": "Got more in common than you think."
  },
  {
   "start": 23.34,
   "end": 25.84,
   "text": "Know exactly what's been going through your mind."
  },
  {
   "start": 26.84,
   "end": 28.84,
   "text": "We have nothing in common."
  },
  {
   "start": 29.84,
   "end": 35.34,
   "text": "The blood you spill now is no different from what they spilled of ours."
  },
  {
   "start": 36.34,
   "end": 38.34,
   "text": "Is your revenge worth this mess?"
  },
  {
   "start": 38.84,
   "end": 56.51,
   "text": "Whatever she did to me, it felt good."
  },
  {
   "start": 56.51,
   "end": 69.71,
   "text": "I hope it's gonna kill you."
  },
  {
   "start": 70.71,
   "end": 72.71,
   "text": "Am I going psycho or not?"
  },
  {
   "start": 73.21,
   "end": 74.71,
   "text": "I'm worried about you."
  },
  {
   "start": 74.71,
   "end": 76.21,
   "text": "Haven't been yourself lately."
  },
  {
   "start": 76.71,
   "end": 78.71,
   "text": "You're a good person. You know that?"
  }
 ],
